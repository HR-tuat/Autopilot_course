{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "rootDir": "src",
        "outDir": "site/assets/js",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "verbatimModuleSyntax": true,
        "sourceMap": false
    },
    "include": ["src"]
}
